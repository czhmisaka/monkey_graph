# ==============================================================================
# Docker 构建忽略文件
# ==============================================================================

# Node.js 依赖（会在容器内重新安装）
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 前端依赖
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Git
.git/
.gitignore
.gitattributes

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 日志文件
*.log
logs/

# 环境变量文件（敏感信息）
.env
.env.local
.env.*.local

# 测试文件
test/
tests/
coverage/
*.test.js
*.spec.js

# 构建产物
dist/
build/
*.tgz

# 文档
*.md
docs/
LICENSE

# Docker 相关（避免递归）
Dockerfile
docker-compose*.yml
.docker/

# 其他
*.bak
*.tmp
*.temp
Thumbs.db

# SQLite 数据库文件（容器启动时会自动创建）
# backend/data/*.db
# backend/data/*.db-*

# 临时文件
tmp/
temp/
.cache/
