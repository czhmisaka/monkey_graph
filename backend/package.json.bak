{
  "name": "monkey_graph_backend",
  "version": "1.0.0",
  "description": "知识图谱后端服务",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node -e \"require('dotenv').config(); require('fs').writeFileSync('.env', require('fs').readFileSync('.env'))\" 2>/dev/null; node src/index.js",
    "dev": "node -e \"require('dotenv').config(); require('fs').writeFileSync('.env', require('fs').readFileSync('.env'))\" 2>/dev/null; node --watch src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.0",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.4",
    "sqlite-vec": "^0.1.7-alpha.2",
    "uuid": "^11.0.5"
  }
}