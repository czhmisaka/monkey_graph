# ==============================================================================
# MonkeyGraph 环境变量配置模板
# ⚠️ 警告: 不要将真实密钥提交到 git !
# 复制此文件为 .env 并填写实际值
# ----------------------------------------------------------------
# 建议: .env 文件设置权限为 600 (chmod 600 backend/.env)
# 轮换流程: 详见 /SECRETS_ROTATION.md
# ==============================================================================

# ==============================================================================
# 🔐 安全密钥配置（生产环境必须配置）
# ==============================================================================

# JWT 密钥（必需 - 用于用户认证 Token 生成）
# 生成方法: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# 加密密钥（必需 - 用于加密敏感数据如 API Keys）
# 生成方法: openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key_here

# 加密算法 (默认值: aes-256-cbc，向后兼容)
# 推荐使用 chacha20-poly1305 (更现代，性能更好，特别是移动设备)
# 可选值: aes-256-cbc, chacha20-poly1305
# ENCRYPTION_ALGORITHM=chacha20-poly1305

# ==============================================================================
# 👤 管理员账户配置（生产环境必须配置）
# ==============================================================================

# 管理员用户名
ADMIN_USERNAME=admin

# 管理员密码（建议使用强密码）
ADMIN_PASSWORD=your_admin_password_here

# ==============================================================================
# MiniMax API 配置（必需）
# ==============================================================================
# MiniMax API 基础 URL
LLM_CLOUD_BASE_URL=https://api.minimaxi.com/v1

# MiniMax 模型名称
LLM_CLOUD_MODEL_NAME=MiniMax-M2.5

# MiniMax API Key（从 MiniMax 平台获取）
LLM_CLOUD_API_KEY=your_api_key_here

# ==============================================================================
# Embedding 模型配置
# ==============================================================================
# Embedding API 地址（本地模型服务，如 LM Studio）
EMBEDDING_URL=http://127.0.0.1:1234

# Embedding 模型名称
EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b

# Embedding 向量维度（qwen3-embedding-4b 为 2560）
EMBEDDING_DIMENSIONS=2560

# ==============================================================================
# 服务配置
# ==============================================================================
# 服务端口
PORT=13001

# 监听地址（0.0.0.0 允许外部访问）
HOST=0.0.0.0

# Node 环境（development / production）
NODE_ENV=development

# ==============================================================================
# 🌐 CORS 跨域配置
# ==============================================================================
# 允许的跨域来源（多个用逗号分隔，生产环境必须配置）
# 示例: ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com
ALLOWED_ORIGINS=http://localhost:13002,http://localhost:5173,http://127.0.0.1:13002,http://127.0.0.1:5173

# ==============================================================================
# 数据库配置（SQLite，无需修改）
# ==============================================================================
# 数据库文件路径（相对于项目根目录）
# DATABASE_PATH=./data/knowledge-graph.db

# ==============================================================================
# 上传文件配置
# ==============================================================================
# 最大文件上传大小（单位：字节，默认 50MB）
# MAX_FILE_SIZE=52428800

# 支持的文件类型
# ALLOWED_FILE_TYPES=.pdf,.md,.txt,.doc,.docx

# ==============================================================================
# 日志配置
# ==============================================================================
# 日志级别：error, warn, info, debug
# LOG_LEVEL=info

# 日志文件路径
# LOG_PATH=./logs/app.log
