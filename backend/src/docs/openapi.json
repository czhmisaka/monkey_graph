{
  "openapi": "3.0.3",
  "info": {
    "title": "MonkeyGraph Agent API",
    "description": "MonkeyGraph 知识图谱系统的 Agent API 接口服务文档",
    "version": "1.0.0",
    "contact": {
      "name": "MonkeyGraph Support",
      "url": "https://github.com/czhmisaka/czh_graph"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:13001",
      "description": "本地开发服务器"
    }
  ],
  "tags": [
    {
      "name": "Agent",
      "description": "Agent 管理相关接口"
    },
    {
      "name": "Graphs",
      "description": "图谱操作相关接口"
    },
    {
      "name": "Nodes",
      "description": "节点操作相关接口"
    },
    {
      "name": "Edges",
      "description": "边操作相关接口"
    },
    {
      "name": "Algorithms",
      "description": "图算法相关接口"
    },
    {
      "name": "Versions",
      "description": "版本管理相关接口"
    },
    {
      "name": "Workspace",
      "description": "工作区相关接口"
    },
    {
      "name": "Query",
      "description": "高级查询与检索接口"
    }
  ],
  "paths": {
    "/api/agent/register": {
      "post": {
        "tags": ["Agent"],
        "summary": "注册新 Agent",
        "description": "注册一个新的 Agent，获取 API Key",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Agent 名称"
                  },
                  "description": {
                    "type": "string",
                    "description": "Agent 描述"
                  },
                  "workspace_id": {
                    "type": "string",
                    "description": "绑定的 Workspace ID"
                  },
                  "permissions": {
                    "type": "object",
                    "description": "权限配置"
                  },
                  "monthly_quota": {
                    "type": "integer",
                    "description": "月度请求配额",
                    "default": 100000
                  }
                }
              },
              "example": {
                "name": "my-agent",
                "description": "My AI Agent",
                "permissions": {
                  "graphs": ["read", "write", "delete"],
                  "nodes": ["read", "write", "delete"],
                  "edges": ["read", "write", "delete"]
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Agent 注册成功",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "agent": {
                    "id": "agent-id",
                    "name": "my-agent",
                    "api_key": "your-api-key",
                    "permissions": {},
                    "monthly_quota": 100000,
                    "requests_used": 0
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    },
    "/api/agent/me": {
      "get": {
        "tags": ["Agent"],
        "summary": "获取当前 Agent 信息",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "agent": {}
                }
              }
            }
          },
          "401": {
            "description": "认证失败"
          }
        }
      },
      "put": {
        "tags": ["Agent"],
        "summary": "更新 Agent 信息",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "is_active": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功"
          }
        }
      }
    },
    "/api/agent/quota": {
      "get": {
        "tags": ["Agent"],
        "summary": "获取配额使用情况",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "quota": {
                    "monthly_quota": 100000,
                    "requests_used": 8,
                    "remaining": 99992,
                    "reset_at": "2026-04-01T00:00:00.000Z"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/rotate-key": {
      "post": {
        "tags": ["Agent"],
        "summary": "轮换 API Key",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "轮换成功",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "api_key": "new-api-key",
                  "message": "请妥善保存新的 API Key，它只会显示一次"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/graphs": {
      "get": {
        "tags": ["Graphs"],
        "summary": "获取图谱列表",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "graphs": []
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Graphs"],
        "summary": "创建图谱",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "name": "My Knowledge Graph",
                "description": "Description"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功"
          }
        }
      }
    },
    "/api/agent/graphs/{graphId}/summary": {
      "get": {
        "tags": ["Graphs"],
        "summary": "获取图谱概览（轻量接口）",
        "description": "获取图谱的轻量概览，包含节点列表和边列表（仅核心字段），适合初步了解图谱结构。",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "图谱 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "example": {
                  "graph": {
                    "id": "graph-id",
                    "name": "图谱名称",
                    "description": "描述",
                    "created_at": "2026-03-24T00:00:00.000Z"
                  },
                  "stats": {
                    "nodeCount": 100,
                    "edgeCount": 250,
                    "typeDistribution": {
                      "person": 30,
                      "organization": 20,
                      "concept": 50
                    }
                  },
                  "nodes": [
                    {"id": "node-1", "label": "节点1", "type": "person"}
                  ],
                  "edges": [
                    {"id": "edge-1", "source": "node-1", "target": "node-2", "label": "关系", "type": "default"}
                  ]
                }
              }
            }
          },
          "404": {
            "description": "图谱不存在"
          }
        }
      }
    },
    "/api/agent/graphs/{graphId}/nodes/search": {
      "get": {
        "tags": ["Query"],
        "summary": "关键词搜索节点 (LIKE)",
        "description": "基于关键词的模糊搜索，支持 label、type、properties 字段搜索，按相关性评分排序",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "图谱 ID"
          },
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "搜索关键词"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "按节点类型过滤"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "页码"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            },
            "description": "每页数量（最大100）"
          }
        ],
        "responses": {
          "200": {
            "description": "搜索成功",
            "content": {
              "application/json": {
                "example": {
                  "keyword": "张三",
                  "total": 25,
                  "page": 1,
                  "limit": 20,
                  "totalPages": 2,
                  "nodes": [
                    {
                      "id": "node-uuid-123",
                      "label": "张三",
                      "type": "person",
                      "properties": { "age": 30 },
                      "score": 30,
                      "created_at": "2024-01-01T00:00:00Z"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "图谱不存在"
          }
        }
      }
    },
    "/api/agent/graphs/{graphId}/nodes": {
      "get": {
        "tags": ["Nodes"],
        "summary": "分页获取节点列表",
        "description": "分页获取图谱的节点列表，支持按类型过滤和字段过滤。",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "图谱 ID"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "页码"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 500
            },
            "description": "每页数量（最大500）"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "按节点类型过滤"
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "返回字段，逗号分隔，如 'id,label,type,properties'"
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "example": {
                  "nodes": [
                    {"id": "node-1", "label": "节点1", "type": "person", "properties": {}}
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 100,
                    "total": 500,
                    "totalPages": 5
                  }
                }
              }
            }
          },
          "404": {
            "description": "图谱不存在"
          }
        }
      }
    },
    "/api/agent/graphs/{graphId}/edges": {
      "get": {
        "tags": ["Edges"],
        "summary": "分页获取边列表",
        "description": "分页获取图谱的边列表，支持字段过滤。",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "图谱 ID"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "页码"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 500
            },
            "description": "每页数量（最大500）"
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "返回字段，逗号分隔，如 'id,source,target,label'"
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "example": {
                  "edges": [
                    {"id": "edge-1", "source": "node-1", "target": "node-2", "label": "关系", "properties": {}}
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 100,
                    "total": 250,
                    "totalPages": 3
                  }
                }
              }
            }
          },
          "404": {
            "description": "图谱不存在"
          }
        }
      }
    },
    "/api/agent/graphs/{graphId}": {
      "get": {
        "tags": ["Graphs"],
        "summary": "获取图谱详情（精简版）",
        "description": "获取图谱基本信息，不包含 nodes 和 edges。获取图谱概览请使用 /summary 接口，获取节点请使用 /nodes 接口。",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "图谱 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "graph": {
                    "id": "graph-id",
                    "name": "图谱名称",
                    "description": "描述",
                    "created_at": "2026-03-24T00:00:00.000Z"
                  }
                }
              }
            }
          },
          "404": {
            "description": "图谱不存在"
          }
        }
      },
      "delete": {
        "tags": ["Graphs"],
        "summary": "删除图谱",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功"
          }
        }
      }
    },
    "/api/agent/graphs/{graphId}/batch/nodes": {
      "post": {
        "tags": ["Nodes"],
        "summary": "批量创建节点",
        "description": "批量创建节点，自动计算 Embedding（可选）",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "default": "default"
                        },
                        "properties": {
                          "type": "object"
                        },
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      }
                    }
                  },
                  "auto_embedding": {
                    "type": "boolean",
                    "default": true
                  }
                }
              },
              "example": {
                "nodes": [
                  {"label": "节点1", "type": "person", "properties": {"name": "张三"}},
                  {"label": "节点2", "type": "organization", "properties": {"name": "公司"}},
                  {"label": "节点3", "type": "concept"}
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "count": 3,
                  "nodes": [],
                  "embedding": {
                    "computed": 3,
                    "total": 3
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Nodes"],
        "summary": "批量更新节点",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "properties": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "nodes": [
                  {"id": "node-id", "label": "新名称", "properties": {"key": "value"}}
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功"
          }
        }
      },
      "delete": {
        "tags": ["Nodes"],
        "summary": "批量删除节点",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "node_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "example": {
                "node_ids": ["node-id-1", "node-id-2"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "删除成功"
          }
        }
      }
    },
    "/api/agent/graphs/{graphId}/batch/edges": {
      "post": {
        "tags": ["Edges"],
        "summary": "批量创建边",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "edges": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string"
                        },
                        "target": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "properties": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "edges": [
                  {"source": "node-id-1", "target": "node-id-2", "label": "关系"},
                  {"source": "node-id-2", "target": "node-id-3", "label": "属于"}
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功"
          }
        }
      }
    },
    "/api/agent/graphs/{graphId}/degrees": {
      "get": {
        "tags": ["Algorithms"],
        "summary": "获取节点度统计",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "获取成功",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "degrees": [
                    {
                      "id": "node-id",
                      "label": "节点",
                      "type": "person",
                      "in": 2,
                      "out": 1,
                      "total": 3
                    }
                  ],
                  "totalEdges": 5
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/graphs/{graphId}/path": {
      "get": {
        "tags": ["Algorithms"],
        "summary": "路径查找 (BFS)",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "源节点 ID"
          },
          {
            "name": "target",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "目标节点 ID"
          },
          {
            "name": "max_depth",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "最大深度"
          }
        ],
        "responses": {
          "200": {
            "description": "查找成功",
            "content": {
