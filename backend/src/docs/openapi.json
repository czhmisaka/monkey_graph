    "/api/agent/graphs/{graphId}/nodes/query": {
      "post": {
        "tags": ["Query"],
        "summary": "属性筛选 + 排序查询（核心接口）",
        "description": "支持属性筛选、多字段排序、数值/字符串排序、分页",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "图谱 ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "节点类型筛选"
                  },
                  "filters": {
                    "type": "array",
                    "description": "筛选条件数组",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "description": "字段名，支持 properties.xxx 或直接属性名"
                        },
                        "operator": {
                          "type": "string",
                          "enum": ["=", "!=", ">", "<", ">=", "<=", "contains", "startsWith", "endsWith", "exists", "in"]
                        },
                        "value": {
                          "type": "any",
                          "description": "筛选值"
                        }
                      }
                    }
                  },
                  "sort": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string"
                          },
                          "order": {
                            "type": "string",
                            "enum": ["asc", "desc"]
                          },
                          "type": {
                            "type": "string",
                            "enum": ["number", "string"],
                            "description": "排序类型，number 使用数值排序"
                          }
                        }
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    ],
                    "description": "排序条件，支持多字段排序"
                  },
                  "pagination": {
                    "type": "object",
                    "properties": {
                      "page": {
                        "type": "integer",
                        "default": 1
                      },
                      "limit": {
                        "type": "integer",
                        "default": 50,
                        "maximum": 1000
                      }
                    }
                  }
                }
              },
              "example": {
                "type": "book",
                "filters": [
                  {"field": "properties.评分", "operator": ">=", "value": 8}
                ],
                "sort": {
                  "field": "评分",
                  "order": "desc",
                  "type": "number"
                },
                "pagination": {
                  "page": 1,
                  "limit": 10
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "example": {
                  "nodes": [],
                  "pagination": {
                    "page": 1,
                    "limit": 10,
                    "total": 100,
                    "totalPages": 10,
                    "hasMore": true
                  }
                }
              }
            }
          }
        }
      }
    },
