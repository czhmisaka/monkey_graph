          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["field", "operations"],
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "聚合字段"
                  },
                  "operations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["sum", "avg", "max", "min", "count"]
                    }
                  },
                  "filters": {
                    "type": "array",
                    "description": "筛选条件"
                  }
                }
              },
              "example": {
                "field": "评分",
                "operations": ["sum", "avg", "max", "min", "count"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "聚合统计成功",
            "content": {
              "application/json": {
                "example": {
                  "field": "评分",
                  "results": {
                    "sum": 125.5,
                    "avg": 8.96,
                    "max": 9.8,
                    "min": 7.5,
                    "count": 14
                  }
                }
              }
            }
          }
        }
      }
    },
