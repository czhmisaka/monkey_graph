    "/api/agent/graphs/{graphId}/nodes/aggregate": {
      "post": {
        "tags": ["Query"],
        "summary": "聚合统计",
        "description": "对节点属性进行聚合计算（求和、平均值、最大值、最小值、计数）",
        "security": [
          {
            "AgentAuth": []
          }
        ],
        "parameters": [
          {
            "name": "graphId",
